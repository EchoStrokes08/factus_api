# ---------------------------------------------------------------------------
# Modo de ejecucion
# ---------------------------------------------------------------------------
# false (por defecto) -> APIs reales de Factus y Factus Pay. Requiere las
#          credenciales de abajo (en Vercel: Settings > Environment Variables).
# true  -> simulador local, sin llamar a Factus.
MOCK_MODE=false

# Factus Pay por separado. false = los cobros van al sandbox real de Factus Pay
# aunque las facturas sean simuladas. Vacio = sigue a MOCK_MODE.
FACTUS_PAY_MOCK_MODE=

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Factus - Facturacion electronica (DIAN)
# https://developers.factus.com.co
# ---------------------------------------------------------------------------
# Obligatorias si MOCK_MODE=false. Nunca las subas al repositorio.
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Rango de numeracion DIAN. Vacio = automatico: el backend consulta
# GET /v2/numbering-ranges y usa el rango activo y vigente de cada documento.
# Llenalos solo para forzar un rango concreto (id numerico de Factus).
FACTUS_BILL_RANGE_ID=
FACTUS_CREDIT_NOTE_RANGE_ID=

# ---------------------------------------------------------------------------
# Factus Pay - Recaudos / collections
# https://pay-developers.factus.com.co
# ---------------------------------------------------------------------------
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=

# ---------------------------------------------------------------------------
# Agente de IA (conversacion por voz/texto)
# https://console.anthropic.com
# ---------------------------------------------------------------------------
# Clave de OpenRouter (sk-or-...) o de Anthropic (sk-ant-...). Vacia = asistente
# guiado sin IA. Modelo y URL vacios = OpenRouter con anthropic/claude-sonnet-4.5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
