    "name": "Factus Voz - Hackathon API Collection",
    "description": "Colección completa de endpoints para Factus Voz: integración con Factus API v2, Factus Pay v1, catálogos DANE DIVIPOLA y agente de voz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "lastInvoiceReference",
      "value": "",
      "type": "string"
    },
    {
      "key": "lastInvoiceNumber",
      "value": "",
