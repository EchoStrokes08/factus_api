{
  "info": {
    "_postman_id": "f8a9271b-7a8e-4a6c-9a4d-71b569e2c601",
    "name": "Factus Voz - Hackathon API Collection",
    "description": "Colección completa de endpoints para Factus Voz: integración con Factus API v2, Factus Pay v1, catálogos DANE DIVIPOLA y agente de voz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "lastInvoiceReference",
      "value": "FACT-POSTMAN-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Salud y Diagnóstico",
      "item": [
        {
          "name": "Health Check (Estado y Mock Mode)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Catálogos DANE y DIAN",
      "item": [
        {
          "name": "Listar Municipios DANE DIVIPOLA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalogs/municipalities",
              "host": ["{{baseUrl}}"],
              "path": ["catalogs", "municipalities"]
            },
            "description": "Obtiene la lista de municipios principales con su codificación oficial de 5 dígitos del DANE (DIVIPOLA) exigida por Factus y la DIAN."
          }
        }
      ]
    },
    {
      "name": "2. Facturas Electrónicas (Invoices)",
      "item": [
        {
          "name": "Crear Factura y Recaudo Factus Pay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.invoice) {",
                  "    pm.collectionVariables.set('lastInvoiceReference', jsonData.data.invoice.data.reference_code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference_code\": \"FACT-POSTMAN-001\",\n  \"observation\": \"Factura de prueba creada desde Postman\",\n  \"customer\": {\n    \"identification\": \"901234567\",\n    \"dv\": \"3\",\n    \"company\": \"Innovacion Colombia S.A.S.\",\n    \"names\": \"Carlos Rodriguez\",\n    \"email\": \"carlos@innovacion.co\",\n    \"phone\": \"3101234567\",\n    \"address\": \"Carrera 7 # 71-21\",\n    \"municipality_code\": \"11001\"\n  },\n  \"items\": [\n    {\n      \"name\": \"Suscripción Anual Facturación Cloud\",\n      \"quantity\": 1,\n      \"price\": 180000,\n      \"tax_rate\": 19\n    },\n    {\n      \"name\": \"Soporte Técnico Especializado\",\n      \"quantity\": 2,\n      \"price\": 45000,\n      \"tax_rate\": 19\n    }\n  ],\n  \"payment\": {\n    \"payment_form\": \"1\",\n    \"payment_method_code\": \"10\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"]
            }
          }
        },
        {
          "name": "Listar Facturas Electrónicas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"]
            }
          }
        },
        {
          "name": "Consultar Detalle de Factura (con CUFE y Pay URL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{lastInvoiceReference}}",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{lastInvoiceReference}}"]
            }
          }
        },
        {
          "name": "Eliminar Factura No Validada",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{lastInvoiceReference}}",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{lastInvoiceReference}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Notas Crédito (Credit Notes)",
      "item": [
        {
          "name": "Crear Nota Crédito (Anulación o Corrección)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference_code\": \"NC-POSTMAN-001\",\n  \"bill_number\": \"SETP9900001001\",\n  \"correction_concept_code\": \"2\",\n  \"items\": [\n    {\n      \"name\": \"Suscripción Anual Facturación Cloud\",\n      \"quantity\": 1,\n      \"price\": 180000,\n      \"tax_rate\": 19\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/credit-notes",
              "host": ["{{baseUrl}}"],
              "path": ["credit-notes"]
            }
          }
        },
        {
          "name": "Listar Notas Crédito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credit-notes",
              "host": ["{{baseUrl}}"],
              "path": ["credit-notes"]
            }
          }
        },
        {
          "name": "Eliminar Nota Crédito No Validada",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credit-notes/NC-POSTMAN-001",
              "host": ["{{baseUrl}}"],
              "path": ["credit-notes", "NC-POSTMAN-001"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Agente de Voz (Conversational Voice AI)",
      "item": [
        {
          "name": "Enviar Turno de Voz al Agente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"postman-session-test\",\n  \"text\": \"Hola, quiero crear una factura para Juan Pérez con cédula 10203040 en Cali por 3 asesorías a 80000 pesos de contado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agent/message",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "message"]
            }
          }
        },
        {
          "name": "Terminar Sesión del Agente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agent/session/postman-session-test",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "session", "postman-session-test"]
            }
          }
        }
      ]
    }
  ]
}
