  "item": [
    {
      "name": "0. Salud y Diagnóstico",
      "item": [
        {
          "name": "Health Check (modo, motor del agente, Factus Pay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Catálogos DANE y DIAN",
      "item": [
        {
          "name": "Listar Municipios DANE DIVIPOLA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalogs/municipalities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "catalogs",
                "municipalities"
              ]
            },
            "description": "Obtiene la lista de municipios principales con su codificación oficial de 5 dígitos del DANE (DIVIPOLA) exigida por Factus y la DIAN."
          }
        },
        {
          "name": "Rangos de numeración activos (GET /v2/numbering-ranges)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Hay rango de facturas', function () {",
                  "    pm.expect(pm.response.json().data.bill).to.not.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/numbering-ranges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "numbering-ranges"
              ]
            },
            "description": "Consulta Factus y devuelve el rango activo y vigente que el backend usará para facturas (bill) y notas crédito (creditNote)."
          }
        }
      ]
    },
    {
      "name": "2. Facturas Electrónicas (Invoices)",
      "item": [
        {
          "name": "Emitir factura + recaudo Factus Pay",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json().data;",
                  "pm.test('Factura validada con CUFE', function () {",
                  "    pm.expect(data.invoice.is_validated).to.be.true;",
                  "    pm.expect(data.invoice.cufe).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set('lastInvoiceReference', data.invoice.reference_code);",
                  "pm.collectionVariables.set('lastInvoiceNumber', data.invoice.number);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference_code\": \"FACT-POSTMAN-{{$timestamp}}\",\n  \"observation\": \"Factura de prueba creada desde Postman\",\n  \"customer\": {\n    \"identification\": \"901234567\",\n    \"dv\": \"3\",\n    \"company\": \"Innovacion Colombia S.A.S.\",\n    \"names\": \"Carlos Rodriguez\",\n    \"email\": \"carlos@innovacion.co\",\n    \"phone\": \"3101234567\",\n    \"address\": \"Carrera 7 # 71-21\",\n    \"municipality_code\": \"11001\"\n  },\n  \"items\": [\n    {\n      \"name\": \"Suscripción Anual Facturación Cloud\",\n      \"quantity\": 1,\n      \"price\": 180000,\n      \"tax_rate\": 19\n    },\n    {\n      \"name\": \"Soporte Técnico Especializado\",\n      \"quantity\": 2,\n      \"price\": 45000,\n      \"tax_rate\": 19\n    }\n  ],\n  \"payment\": {\n    \"payment_form\": \"1\",\n    \"payment_method_code\": \"10\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ]
            },
            "description": "numbering_range_id se resuelve solo con GET /v2/numbering-ranges. El cobro nunca tumba la factura: collection.status puede ser started, skipped, disabled o error."
          }
        },
        {
          "name": "Listar facturas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ]
            }
          }
        },
        {
          "name": "Detalle por número DIAN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{lastInvoiceNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
