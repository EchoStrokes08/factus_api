              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{lastInvoiceReference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{lastInvoiceReference}}"
              ]
            }
          }
        },
        {
          "name": "Estado del cobro en Factus Pay (QR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{lastInvoiceReference}}/collection",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{lastInvoiceReference}}",
                "collection"
              ]
            }
          }
        },
        {
          "name": "PDF oficial DIAN (solo MOCK_MODE=false)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{lastInvoiceNumber}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{lastInvoiceNumber}}",
                "pdf"
              ]
            }
          }
        },
        {
          "name": "Eliminar o anular factura",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Validada => anulada con nota crédito', function () {",
                  "    var data = pm.response.json().data;",
                  "    pm.expect(['voided', 'deleted', 'already_voided']).to.include(data.outcome);",
                  "    if (data.outcome === 'voided') pm.expect(data.creditNote.concept_code).to.eql('2');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{lastInvoiceReference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{lastInvoiceReference}}"
              ]
            },
            "description": "Sin CUFE: DELETE /v2/bills/destroy/reference. Con CUFE: nota crédito de anulación (concepto 2) con referencia ANUL-<referencia>; repetir la petición no crea una segunda nota."
          }
        }
      ]
    },
    {
      "name": "3. Notas Crédito (Credit Notes)",
      "item": [
        {
          "name": "Nota crédito parcial (devolución)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('lastCreditNoteReference', pm.response.json().data.reference_code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bill_number\": \"{{lastInvoiceNumber}}\",\n  \"correction_concept_code\": \"1\",\n  \"items\": [\n    {\n      \"name\": \"Suscripción Anual Facturación Cloud\",\n      \"quantity\": 1,\n      \"price\": 180000,\n      \"tax_rate\": 19\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/credit-notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credit-notes"
              ]
            },
            "description": "Para anular una factura completa usa DELETE /invoices/:identifier. Conceptos: 1 devolución, 3 descuento, 4 ajuste de precio."
          }
        },
        {
          "name": "Listar notas crédito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credit-notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credit-notes"
              ]
            }
          }
        },
        {
          "name": "Eliminar nota crédito no validada",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credit-notes/{{lastCreditNoteReference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credit-notes",
                "{{lastCreditNoteReference}}"
              ]
            },
            "description": "Una nota validada por la DIAN responde 409: la ley no permite borrarla."
          }
        }
      ]
    },
    {
